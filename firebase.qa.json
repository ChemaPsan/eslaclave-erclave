{
  "hosting": {
    "site": "erclave",
    "public": "dist/qa-frontend",
    "ignore": [
      "firebase.qa.json",
      "**/*.log",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
